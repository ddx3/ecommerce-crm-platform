# ============================================================
#  PRODUCTION .env  — copy to .env and fill in real values
#  REPLACE your-domain.com with your own domain everywhere.
#  The .env file is NOT committed to git (.gitignore).
# ============================================================

# ── Django core ──
DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
LOG_LEVEL=INFO
# Number of uvicorn workers (web). Rule of thumb: (CPU cores * 2) + 1, minimum 2-3.
WEB_CONCURRENCY=3

# Site domain(s), comma-separated, without http://
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ── Database (PostgreSQL in Docker) ──
# POSTGRES_* is read by the postgres container, DB_* by Django.
# IMPORTANT: the three pairs of values below must match.
POSTGRES_DB=shop_db
POSTGRES_USER=shop_user
# NEW password for production (not from the dev environment!)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DB_ENGINE=postgresql
DB_NAME=shop_db
DB_USER=shop_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# ── Redis (cache + WebSocket chat) ──
REDIS_URL=redis://redis:6379/0

# ── CORS / CSRF (frontend and backend on the same domain) ──
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Site URLs ──
SITE_NAME=Magiya Roslyn
SITE_URL=https://your-domain.com
# E-mail of the shop owner: only this account sees analytics, courses and site settings in the CRM
OWNER_EMAIL=owner@your-domain.com
BACKEND_URL=https://your-domain.com

# ── HTTPS (enable AFTER the SSL certificate is issued) ──
# Until there is a certificate, set False, otherwise the site goes into a redirect loop.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── JWT ──
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# ── Email (SMTP) ──
# ⚠️ Many VPSes block outgoing ports 465 and 25. If sending hangs with
# "Connection timed out", use port 587 + STARTTLS (below), not 465/SSL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ── Payments: Monobank ──
MONOBANK_TOKEN=
MONOBANK_API_BASE=https://api.monobank.ua
MONOBANK_PERSONAL_TOKEN=
MONOBANK_PERSONAL_WEBHOOK_SECRET=
PRIVAT_BUSINESS_TOKEN=
PRIVAT_BUSINESS_CLIENT_ID=

# ── Shipping ──
NOVA_POSHTA_API_KEY=

# ── AI (optional) ──
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Flora plant-assistant (MyPlantApp) feed ──
# SHOP_FLORA_API_SECRET: gate for /api/internal/flora/catalog/ (by-id + delta). MUST
#   equal Flora's SHOP_API_SECRET.
# FLORA_WEBHOOK_URL: Flora's webhook, e.g. https://flora.example.com/internal/catalog/changed
# FLORA_WEBHOOK_SECRET: sent as X-Cron-Secret to that webhook. MUST equal Flora's
#   FLORA_WEBHOOK_SECRET.
SHOP_FLORA_API_SECRET=
FLORA_WEBHOOK_URL=
FLORA_WEBHOOK_SECRET=
