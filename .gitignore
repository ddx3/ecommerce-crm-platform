backend/backups/

# Database backups (local, not in git)
backups/

# MCP config — contains tokens (GITHUB_PERSONAL_ACCESS_TOKEN), kept locally
.mcp.json

# Stray/one-off artifacts (not needed in the repo/production)
frontend/frontend/
*_done.log

# Local catalog embeddings cache (regenerated)
backend/.embed_cache/

# Log of the background embeddings indexing (warm_embeddings) — temporary artifact
backend/warm_embeddings.log

# Local dev server logs (the harness writes to the root) — not in the repo.
# No dot in the pattern: the harness writes both dev_backend.log and dev_backend_err.log.
/dev_backend*
/dev_frontend*

# Generated instruction exports and printout backups — local artifacts
/backend/_exports/

# Shared requests folder for shop-helper on the VPS (ops/shop_helper.py)
ops-queue/

# Local working materials (exports, printouts) — not in the repo
/assets/
