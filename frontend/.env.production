# Production web analytics config. Committed (unlike .env): the Measurement ID is
# public (visible in the HTML of any site with GA4), not a secret. Needed here so that
# the production build (git pull → vite build) picks up GA4 without manual steps on the server.
# Meta Pixel / Google Ads are empty: there is no advertising, the pixels are not loaded.

VITE_GA4_ID=

VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_PURCHASE_LABEL=
VITE_META_PIXEL_ID=
