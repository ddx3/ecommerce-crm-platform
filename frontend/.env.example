# Storefront web analytics (Phase 0). Copy to .env and enter your own IDs.
# Any empty/unset key → the corresponding pixel is simply not loaded (no-op).

# Google Analytics 4 — Measurement ID, format G-XXXXXXXXXX
VITE_GA4_ID=

# Google Ads — Conversion ID, format AW-XXXXXXXXXX (for retargeting/conversions)
VITE_GOOGLE_ADS_ID=
# Conversion label "purchase" for Google Ads: a send_to value like
# AW-XXXXXXXXXX/AbC-D_efGh
# (created in Google Ads → Goals → Conversion "Purchase"). Without it, purchase is sent only to GA4.
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# Meta (Facebook) Pixel — numeric pixel ID
VITE_META_PIXEL_ID=
